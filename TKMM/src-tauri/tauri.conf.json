{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TK's Mod Manager",
  "version": "0.1.0",
  "identifier": "tkmm",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TK's Mod Manager (TKMM)",
        "width": 920,
        "height": 700,
        "minWidth": 600,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/addons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../Outputs/": "addons/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3OEExNTNDN0U1RDc1QzIKUldUQ2RWMStQQldLUnl2bzRVbVFINm4rVVR3VWlmTllIb1k1ckNpSTY2eU9VSnpFeUJxWndMQ0UK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ]
    }
  }
}
